# Etapa 1: Compilación de la aplicación (Build)
FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app

# Copiar archivos de dependencias y código fuente
COPY pom.xml .
COPY src ./src

# Compilar el proyecto omitiendo los tests para acelerar el despliegue
RUN mvn clean package -DskipTests

# Etapa 2: Imagen ligera para ejecución (Runtime)
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Copiar el ejecutable .jar generado en la etapa anterior
COPY --from=build /app/target/*.jar app.jar

# Exponer el puerto por defecto de Spring Boot
EXPOSE 8080

# Comando para arrancar la aplicación
ENTRYPOINT ["java", "-jar", "app.jar"]